<StatusMessage Message="@StatusMessage" />

<div class="mb-4">
    <h4 class="fw-bold mb-2 d-flex align-items-center gap-2" style="color: #f8fafc;">
        <i class="bi bi-shield-lock" style="color: #10b981;"></i>
        <span>Recovery Codes</span>
    </h4>
    <div class="alert alert-warning my-3" role="alert">
        <strong>Put these codes in a safe place!</strong>
        <p class="mb-0 small">If you lose your device and don't have the recovery codes you will lose access to your account. Each code can be used only once.</p>
    </div>
</div>

<div class="p-3 rounded-3 mb-4" style="background-color: #191e24; border: 1px solid #384252;">
    <div class="row g-2">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div class="col-6 col-sm-4">
                <div class="p-2 text-center rounded font-monospace" style="background-color: #2a323c; border: 1px solid #384252; color: #10b981; font-weight: 600; letter-spacing: 0.1em;">
                    @recoveryCode
                </div>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a href="Account/Manage/TwoFactorAuthentication" class="btn btn-primary px-4 py-2 fw-bold">Saved, Return to 2FA</a>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
