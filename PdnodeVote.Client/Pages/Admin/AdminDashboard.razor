                <span>Confirm Rejection</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Remove Comment -->
<MudDialog @bind-Visible="_showRemoveCommentDialog" Options="_dialogOptions">
