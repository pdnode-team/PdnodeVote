    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEmailDialog = false)" Disabled="_isSendingEmail">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmBulkEmailAsync" Disabled="_isSendingEmail">
            @if (_isSendingEmail)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Sending...</span>
            }
            else
            {
                <span>Send Email</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Reject Category Request -->
