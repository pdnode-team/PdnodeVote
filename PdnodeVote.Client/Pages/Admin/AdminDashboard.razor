    private async Task LoadUsersAsync()
    {
        _users = await AdminApi.GetUsersAsync(1, 100, _userSearch);
        if (!string.IsNullOrWhiteSpace(_roleFilter))
        {
            _users = _users.Where(u => u.Roles.Contains(_roleFilter)).ToList();
        }
        if (_bannedOnly)
        {
            _users = _users.Where(u => u.IsCurrentlyBanned).ToList();
        }
        _selectedUserIds.RemoveWhere(id => !_users.Any(u => u.Id == id));
    }

