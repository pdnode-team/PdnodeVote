@code {
    private bool _isCheckingAuth = true;
    private bool _canAccess = false;
    private bool _isAdmin = false;
    private bool _isSuperModerator = false;
    private bool _isModerator = false;
    private string _currentUserId = string.Empty;

    private AdminDashboardStatsDto? _stats;
    private List<PendingReviewPollDto> _pendingPolls = new();
    private List<PollListItemDto> _adminPolls = new();
    private List<AdminUserDto> _users = new();

    // Categories & Comments Queue
    private List<CategoryRequestDto> _categoryRequests = new();
    private List<PendingCommentDto> _pendingComments = new();
    private List<ContentReportDto> _pendingReports = new();

    private bool _showRejectCategoryDialog;
    private int _rejectCategoryTargetId;
    private string _rejectCategoryTargetName = "";
    private string _rejectCategoryReason = "";

    private bool _showRemoveCommentDialog;
    private int _removeCommentTargetId;
    private string _removeCommentReason = "";

    // Filters
    private string _allPollsSearch = string.Empty;
    private PollStatus? _filterStatus = null;
    private string _userSearch = string.Empty;
    private string _roleFilter = string.Empty;
    private bool _bannedOnly = false;

    // Selection
    private HashSet<string> _selectedUserIds = new();
    private bool _isAllUsersSelected => _users.Count > 0 && _selectedUserIds.Count == _users.Count;

    // Dialog state
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private int _actionPollId;
    private string _actionPollTitle = string.Empty;
    private bool _showReturnDialog;
    private string _returnReason = string.Empty;
    private bool _showRemoveDialog;
    private string _removeReason = string.Empty;

    // Ban dialog state
    private bool _showBanDialog;
    private List<string> _targetBanUserIds = new();
    private bool _banIsPermanent = false;
    private int _banDays = 7;
    private string _banReason = string.Empty;

    // Email dialog state
    private bool _showEmailDialog;
    private string _emailSubject = string.Empty;
    private string _emailBody = string.Empty;

    // Loading & action states
    private int? _approvingPollId = null;
    private bool _isSubmittingAction = false;
    private bool _isSendingEmail = false;
    private bool _isBusy => _approvingPollId.HasValue || _isSubmittingAction || _isSendingEmail;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            _isAdmin = user.IsInRole("Admin") || _currentUserId == "00000000-0000-0000-0000-000000000000";
            _isSuperModerator = user.IsInRole("SuperModerator");
            _isModerator = user.IsInRole("Moderator") || _isSuperModerator;
            _canAccess = _isAdmin || _isModerator;
        }

        _isCheckingAuth = false;

        if (_canAccess)
        {
            await LoadPendingPollsAsync();
            await LoadCategoryRequestsAsync();
            await LoadPendingCommentsAsync();
            await LoadReportsAsync();

            if (_isAdmin)
            {
                await LoadStatsAsync();
                await LoadAdminPollsAsync();
                await LoadUsersAsync();
                await LoadAnnouncementAsync();
            }
        }
    }

    // Announcement state
    private bool _announcementActive = false;
    private string _announcementMessage = "";
    private string? _announcementTargetUrl;
    private bool _isSavingAnnouncement = false;

    private async Task LoadAnnouncementAsync()
    {
        try
        {
            var a = await PollApi.GetActiveAnnouncementAsync();
            if (a != null)
            {
                _announcementActive = a.IsActive;
                _announcementMessage = a.Message;
                _announcementTargetUrl = a.TargetUrl;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcement: {ex.Message}");
        }
    }

    private async Task SaveAnnouncementAsync()
    {
        if (_announcementActive && string.IsNullOrWhiteSpace(_announcementMessage))
        {
            Snackbar.Add("Announcement message cannot be empty when active.", Severity.Warning);
            return;
        }

        _isSavingAnnouncement = true;
        try
        {
            var req = new UpdateAnnouncementRequest
            {
                IsActive = _announcementActive,
                Message = _announcementMessage.Trim(),
                TargetUrl = string.IsNullOrWhiteSpace(_announcementTargetUrl) ? null : _announcementTargetUrl.Trim()
            };

            var res = await PollApi.UpdateAnnouncementAsync(req);
            if (res.Success)
            {
                Snackbar.Add("Announcement updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update announcement: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingAnnouncement = false;
        }
    }

