    private async Task ResolveReportAsync(int reportId, bool removeContent, bool banUser, string reason)
    {
        _isSubmittingAction = true;
        try
        {
            var req = new ResolveReportRequest
            {
                Dismiss = !removeContent && !banUser,
                RemoveContent = removeContent,
                BanAuthor = banUser,
                Notes = reason
            };
            var res = await AdminApi.ResolveReportAsync(reportId, req);
            if (res.Success)
            {
                Snackbar.Add(res.Message, Severity.Success);
                await LoadReportsAsync();
                if (removeContent)
                {
                    await LoadAdminPollsAsync();
                    await LoadPendingCommentsAsync();
                }
                if (banUser)
                {
                    await LoadUsersAsync();
                }
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Resolve failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    /// <summary>
    /// Formats a server timestamp in the viewer's local time.
    /// </summary>
    /// <remarks>
    /// The API serializes UTC without a zone marker, so values arrive with
    /// <see cref="DateTimeKind.Unspecified"/> and calling <c>ToLocalTime()</c> directly is a no-op —
    /// every user outside UTC saw UTC. Normalizing the Kind first is what makes the conversion work.
    /// </remarks>
    private static string FormatLocal(DateTime value, string format)
    {
        var utc = value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };

        return utc.ToLocalTime().ToString(format, System.Globalization.CultureInfo.InvariantCulture);
    }
