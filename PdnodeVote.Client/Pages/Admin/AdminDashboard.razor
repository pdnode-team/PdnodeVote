    private void OpenBulkBanDialog()
    {
        _targetBanUserIds = _selectedUserIds.ToList();
        _banIsPermanent = false;
        _banDays = 7;
        _banReason = string.Empty;
        _showBanDialog = true;
    }

    private async Task ConfirmBanUsersAsync()
    {
        if (string.IsNullOrWhiteSpace(_banReason))
        {
            Snackbar.Add("Please provide a suspension reason.", Severity.Warning);
            return;
        }

        _isSubmittingAction = true;
        try
        {
            int count = 0;
            foreach (var uid in _targetBanUserIds)
            {
                var res = await AdminApi.BanUserAsync(new BanUserRequest
                {
                    UserId = uid,
                    BanType = _banIsPermanent ? "Permanent" : "Temporary",
                    DurationDays = _banDays,
                    Reason = _banReason
                });
                if (res.Success) count++;
            }

            _showBanDialog = false;
            Snackbar.Add($"Suspended {count} user(s).", count > 0 ? Severity.Success : Severity.Warning);
            await LoadUsersAsync();
            await LoadStatsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Suspension error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

