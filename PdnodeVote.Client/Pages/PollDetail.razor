    private void OpenEditDialog()
    {
        if (_poll == null) return;
        _editTitle = _poll.Title;
        _editDescription = _poll.Description;
        _editOptions = _poll.Options.Select(o => o.Text).ToList();
        if (_editOptions.Count < 2)
        {
            while (_editOptions.Count < 2) _editOptions.Add(string.Empty);
        }
        _showEditDialog = true;
    }

    private async Task ConfirmResubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_editTitle))
        {
            Snackbar.Add("Poll title is required.", Severity.Warning);
            return;
        }

        var validOptions = _editOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
        if (validOptions.Count < 2)
        {
            Snackbar.Add("At least 2 valid options are required.", Severity.Warning);
            return;
        }

        _isResubmitting = true;
        try
        {
            var res = await PollApi.ResubmitPollAsync(Id, new ResubmitPollRequest
            {
                Title = _editTitle,
                Description = _editDescription,
                Options = validOptions
            });
            _showEditDialog = false;
            if (res.Success)
            {
                Snackbar.Add(res.Message, Severity.Success);
                await LoadPollDetailAsync();
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Resubmit failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isResubmitting = false;
        }
    }

