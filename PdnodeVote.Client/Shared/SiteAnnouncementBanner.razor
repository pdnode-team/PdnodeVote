@using PdnodeVote.Client.Models
@inject IPollApiClient PollApi

@if (_announcement != null && _announcement.IsActive && !_isDismissed)
{
    <div class="site-announcement-banner">
        <div class="announcement-inner">
            <span class="announcement-tag">Notice</span>
            <span class="announcement-text">@_announcement.Message</span>
            @if (!string.IsNullOrEmpty(_announcement.TargetUrl))
            {
                <a href="@_announcement.TargetUrl" class="announcement-link" target="_blank" rel="noopener noreferrer">
                    Learn more →
                </a>
            }
        </div>
        <button type="button" class="announcement-close-btn" @onclick="Dismiss" title="Dismiss announcement">
            ✕
        </button>
    </div>
}

<style>
    .site-announcement-banner {
        background: linear-gradient(90deg, rgba(16, 185, 129, 0.12) 0%, rgba(56, 189, 248, 0.12) 100%);
        border-bottom: 1px solid rgba(16, 185, 129, 0.25);
        padding: 6px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        color: #f1f5f9;
        position: relative;
        z-index: 100;
        animation: fadeIn 0.2s ease-out;
    }

    .announcement-inner {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        flex-grow: 1;
        justify-content: center;
        padding-right: 24px;
    }

    .announcement-tag {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: #10b981;
        color: #ffffff;
        padding: 1px 6px;
        border-radius: 4px;
    }

    .announcement-text {
        font-weight: 500;
        color: #e2e8f0;
    }

    .announcement-link {
        color: #38bdf8;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.15s ease;
    }

    .announcement-link:hover {
        color: #7dd3fc;
    }

    .announcement-close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 14px;
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
        line-height: 1;
        transition: color 0.15s ease;
        flex-shrink: 0;
    }

    .announcement-close-btn:hover {
        color: #f8fafc;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private SystemAnnouncementDto? _announcement;
    private bool _isDismissed = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _announcement = await PollApi.GetActiveAnnouncementAsync();
        }
        catch
        {
            // Silent fallback if offline or during pre-render
        }
    }

    private void Dismiss()
    {
        _isDismissed = true;
    }
}
