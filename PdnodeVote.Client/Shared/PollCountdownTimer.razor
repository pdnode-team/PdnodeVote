@implements IDisposable

@if (ExpiresAt.HasValue && !IsExpired && _remaining.TotalSeconds > 0)
{
    <span class="countdown-pill" title="@($"Closes at {ExpiresAt.Value.ToLocalTime():MMM dd, yyyy HH:mm}")">
        <svg style="width: 12px; height: 12px; fill: currentColor; margin-right: 4px; flex-shrink: 0;" viewBox="0 0 24 24">
            <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
        </svg>
        Ends in @_timeString
    </span>
}

<style>
    .countdown-pill {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 600;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        padding: 2px 8px;
        border-radius: 4px;
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
        letter-spacing: -0.01em;
    }
</style>

@code {
    [Parameter]
    public DateTime? ExpiresAt { get; set; }

    [Parameter]
    public bool IsExpired { get; set; }

    [Parameter]
    public EventCallback OnTimerExpired { get; set; }

    private TimeSpan _remaining = TimeSpan.Zero;
    private string _timeString = "";
    private System.Threading.Timer? _timer;

    protected override void OnParametersSet()
    {
        UpdateRemaining();
        if (_timer == null && ExpiresAt.HasValue && !IsExpired)
        {
            _timer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    UpdateRemaining();
                    StateHasChanged();
                });
            }, null, 1000, 1000);
        }
    }

    private void UpdateRemaining()
    {
        if (!ExpiresAt.HasValue || IsExpired)
        {
            _remaining = TimeSpan.Zero;
            _timeString = "";
            return;
        }

        var diff = ExpiresAt.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _remaining = TimeSpan.Zero;
            _timeString = "Ended";
            _timer?.Dispose();
            _timer = null;
            _ = OnTimerExpired.InvokeAsync();
        }
        else
        {
            _remaining = diff;
            if (diff.TotalDays >= 1)
            {
                _timeString = $"{(int)diff.TotalDays}d {diff.Hours}h {diff.Minutes}m";
            }
            else if (diff.TotalHours >= 1)
            {
                _timeString = $"{diff.Hours:D2}h {diff.Minutes:D2}m {diff.Seconds:D2}s";
            }
            else
            {
                _timeString = $"{diff.Minutes:D2}m {diff.Seconds:D2}s";
            }
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
