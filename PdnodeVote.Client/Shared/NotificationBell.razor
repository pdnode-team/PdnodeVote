    .notif-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background-color: #15191e;
        border-bottom: 1px solid #2a323c;
    }

    .notif-modal-type-badge {
        font-size: 13px;
        font-weight: 700;
        color: #f8fafc;
        letter-spacing: -0.01em;
    }

    .notif-modal-time {
        font-size: 12px;
        color: #64748b;
        margin-top: 2px;
    }

    .notif-modal-close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .notif-modal-close-btn:hover {
        background-color: rgba(255, 255, 255, 0.08);
        color: #f8fafc;
    }

    .notif-modal-body {
        padding: 22px 20px;
    }

    .notif-modal-title {
        font-size: 17px;
        font-weight: 700;
        color: #f8fafc;
        margin: 0 0 14px 0;
        line-height: 1.4;
    }

    .notif-modal-desc {
        font-size: 14px;
        color: #cbd5e1;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 14px 16px;
    }

    .notif-modal-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 20px;
        background-color: #15191e;
        border-top: 1px solid #2a323c;
    }

    .notif-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid transparent;
    }

    .notif-btn-secondary {
        background-color: #2a323c;
        color: #cbd5e1;
        border-color: #384252;
    }

    .notif-btn-secondary:hover {
        background-color: #323b46;
        color: #f8fafc;
    }

    .notif-btn-primary {
        background-color: #10b981;
        color: #ffffff;
    }

    .notif-btn-primary:hover {
        background-color: #059669;
    }
</style>

@code {
    private bool _isOpen;
    private int _unreadCount;
    private List<NotificationDto> _notifications = new();
    private bool _loading;
    private HubConnection? _hubConnection;
    private string? _userId;
    private NotificationDto? _selectedNotification;
    private bool _initialized;
    private System.Threading.Timer? _retryTimer;

    protected override async Task OnInitializedAsync()
    {
        // Loading twice (here and in OnAfterRenderAsync) issued every notification request twice, so
        // the initial load lives only in OnAfterRenderAsync, which runs on the interactive renderer.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CheckAuthAndLoadAsync();

        // Retry the hub connection if the first attempt failed (typically because it ran during
        // server-side prerender). Throttled so a persistent failure cannot spin.
        if (!_initialized)
        {
            _retryTimer ??= new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(async () =>
                {
                    await CheckAuthAndLoadAsync();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(15));
        }

        StateHasChanged();
    }

    private async Task CheckAuthAndLoadAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    _userId = userId;
                }
                await RefreshCountAsync();

                if (!_initialized && !string.IsNullOrEmpty(_userId))
                {
                    // Only mark initialised once the hub is actually connected. This runs during
                    // server-side prerender too, where [Authorize] on the hub means StartAsync cannot
                    // succeed; flagging success there (as the previous code did) permanently suppressed
                    // the retry, so push notifications never arrived and the bell only updated when the
                    // user opened it and triggered an HTTP refresh.
                    _initialized = await SetupSignalRAsync();
                }
            }
        }
        catch
        {
            // Silently ignore during prerender
        }
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            _unreadCount = await PollApi.GetUnreadNotificationCountAsync();
        }
        catch
        {
            // Ignore during prerender
        }
    }

    private async Task ToggleOpenAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private void CloseMenu()
    {
        _isOpen = false;
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _loading = true;
            _unreadCount = await PollApi.GetUnreadNotificationCountAsync();
            _notifications = await PollApi.GetNotificationsAsync(15);
        }
        catch
        {
            // Ignore
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Connects the hub and subscribes to this user's notification group.
    /// </summary>
    /// <returns>
    /// True only when the connection started and the group join succeeded; false lets the caller retry
    /// on a later render (see CheckAuthAndLoadAsync).
    /// </returns>
    private async Task<bool> SetupSignalRAsync()
    {
        try
        {
            if (_hubConnection is not null)
            {
                return true;
            }

            var hubUrl = Navigation.ToAbsoluteUri("/hubs/poll");
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<int, NotificationDto>("NotificationReceived", (unreadCount, notification) =>
            {
                // Mutate only inside InvokeAsync: the hub callback runs on a SignalR thread while the
                // renderer may be enumerating _notifications, so mutating first and hopping afterwards
                // risked a torn read or a lost update under server-interactive rendering.
                _ = InvokeAsync(() =>
                {
                    _unreadCount = unreadCount;
                    _notifications.Insert(0, notification);
                    if (_notifications.Count > 20) _notifications.RemoveAt(_notifications.Count - 1);
                    StateHasChanged();
                });
            });

            // SignalR does not restore group membership after a reconnect, so re-join.
            _hubConnection.Reconnected += async _ =>
            {
                try
                {
                    await _hubConnection.SendAsync("JoinUserGroup");
                }
                catch
                {
                    // Ignore: the bell still refreshes on demand.
                }
            };

            await _hubConnection.StartAsync();

            // The server derives the group from the authenticated identity, so no id is sent.
            await _hubConnection.SendAsync("JoinUserGroup");
            return true;
        }
        catch (Exception ex)
        {
            // Not fatal: prerender (or a hub outage) lands here, and returning false makes the caller
            // retry later instead of silently giving up on real-time notifications forever.
            Console.WriteLine($"[NotificationBell] SignalR setup failed, will retry: {ex.Message}");

            if (_hubConnection is not null)
            {
                await _hubConnection.DisposeAsync();
                _hubConnection = null;
            }

            return false;
        }
    }

    private async Task MarkAllAsRead()
    {
        var res = await PollApi.MarkNotificationsAsReadAsync(null);
        if (!res.Success)
        {
            // Previously the badge was zeroed regardless, so a failed or rate-limited call left the
            // UI claiming everything was read until a reload.
            Snackbar.Add(res.Message ?? "Could not mark notifications as read.", Severity.Error);
            return;
        }

        _unreadCount = 0;
        foreach (var n in _notifications) n.IsRead = true;
        StateHasChanged();
    }

    private async Task OpenDetailModal(NotificationDto item)
    {
        _selectedNotification = item;
        _isOpen = false; // close the dropdown menu

        if (item.IsRead) return;

        // Optimistic, but the result is now awaited so a failure can be reverted instead of being
        // silently discarded (the write used to be fire-and-forget).
        var wasRead = item.IsRead;
        item.IsRead = true;
        _unreadCount = Math.Max(0, _unreadCount - 1);

        var res = await PollApi.MarkNotificationsAsReadAsync(item.Id);
        if (!res.Success)
        {
            item.IsRead = wasRead;
            _unreadCount = Math.Min(_notifications.Count, _unreadCount + 1);
            Snackbar.Add(res.Message ?? "Could not mark the notification as read.", Severity.Error);
            StateHasChanged();
        }
    }

    private void CloseDetailModal()
    {
        _selectedNotification = null;
    }

    private void GoToTargetUrl()
    {
        if (_selectedNotification != null && !string.IsNullOrWhiteSpace(_selectedNotification.TargetUrl))
        {
            var url = _selectedNotification.TargetUrl;
            _selectedNotification = null;
            Navigation.NavigateTo(url);
        }
    }

    private static string GetCategoryName(int type) => type switch
    {
        1 => "Poll Approved",
