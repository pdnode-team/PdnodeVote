@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using PdnodeVote.Client.Models
@using PdnodeVote.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IPollApiClient PollApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<div class="notification-bell-container">
    <!-- Bell Trigger Button -->
    <button type="button"
            class="notification-bell-btn @(_isOpen ? "active" : "")"
            @onclick="ToggleOpenAsync"
            aria-label="Notifications"
            title="Notifications">
        <svg class="bell-icon" viewBox="0 0 24 24">
            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" />
        </svg>
        @if (_unreadCount > 0)
        {
            <span class="notification-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
        }
    </button>

    @if (_isOpen)
    {
        <!-- Transparent Backdrop to catch clicks outside dropdown -->
        <div class="notification-backdrop" @onclick="CloseMenu"></div>

        <!-- Dropdown Panel -->
        <div class="notification-dropdown-panel animate-scale-in" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="notif-header">
                <div class="d-flex align-center gap-2">
                    <span class="notif-header-title">Notifications</span>
                    @if (_unreadCount > 0)
                    {
                        <span class="notif-unread-pill">@_unreadCount unread</span>
                    }
                </div>
                @if (_unreadCount > 0)
                {
                    <button type="button" class="notif-mark-read-btn" @onclick="MarkAllAsRead">
                        Mark all as read
                    </button>
                }
            </div>

            <!-- List -->
            <div class="notif-list-container">
                @if (_loading)
                {
                    <div class="notif-loading">
                        <div class="notif-spinner"></div>
                        <span>Loading notifications...</span>
                    </div>
                }
                else if (_notifications.Count == 0)
                {
                    <div class="notif-empty">
                        <svg class="notif-empty-icon" viewBox="0 0 24 24">
                            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" />
                        </svg>
                        <div class="notif-empty-title">No notifications yet</div>
                        <div class="notif-empty-sub">You will receive alerts for review updates and replies</div>
                    </div>
                }
                else
                {
                    @foreach (var item in _notifications)
                    {
                        <div class="notif-item @(item.IsRead ? "read" : "unread")"
                             @onclick="@(() => OpenDetailModal(item))">
                            <div class="notif-icon-box @GetIconClass(item.Type)">
                                @((MarkupString)GetIconSvg(item.Type))
                            </div>
                            <div class="notif-body">
                                <div class="notif-row">
                                    <span class="notif-title">@item.Title</span>
                                    <span class="notif-time">@FormatTimeAgo(item.CreatedAt)</span>
                                </div>
                                <div class="notif-desc">@item.Message</div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <span class="notif-dot" title="Unread"></span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- True Fullscreen Notification Details Modal Popup -->
    @if (_selectedNotification != null)
    {
        <div class="notif-fullscreen-overlay">
            <div class="notif-modal-backdrop" @onclick="CloseDetailModal"></div>
            <div class="notif-modal-container" role="dialog" aria-modal="true">
                <div class="notif-modal-card animate-modal-in" @onclick:stopPropagation="true">
                    <!-- Modal Header -->
                    <div class="notif-modal-header">
                        <div class="d-flex align-center gap-3">
                            <div class="notif-icon-box @GetIconClass(_selectedNotification.Type)">
                                @((MarkupString)GetIconSvg(_selectedNotification.Type))
                            </div>
                            <div>
                                <div class="notif-modal-type-badge">@GetCategoryName(_selectedNotification.Type)</div>
                                <div class="notif-modal-time">
                                    @FormatLocal(_selectedNotification.CreatedAt, "yyyy-MM-dd HH:mm") · @FormatTimeAgo(_selectedNotification.CreatedAt)
                                </div>
                            </div>
                        </div>
                        <button type="button" class="notif-modal-close-btn" @onclick="CloseDetailModal" title="Close">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </svg>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="notif-modal-body">
                        <h3 class="notif-modal-title">@_selectedNotification.Title</h3>
                        <div class="notif-modal-desc">@_selectedNotification.Message</div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="notif-modal-footer">
                        <button type="button" class="notif-btn notif-btn-secondary" @onclick="CloseDetailModal">
                            Close
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_selectedNotification.TargetUrl))
                        {
                            <button type="button" class="notif-btn notif-btn-primary" @onclick="GoToTargetUrl">
                                <span>View Details</span>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42 5.43 5.43H5v2z" />
                                </svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .notification-bell-container {
        position: relative;
        display: inline-flex;
        align-items: center;
        margin-right: 4px;
    }

    .notification-bell-btn {
        position: relative;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: transparent;
        border: 1px solid transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 0;
        transition: all 0.2s ease;
        outline: none;
    }

    .notification-bell-btn:hover,
    .notification-bell-btn.active {
        background-color: rgba(255, 255, 255, 0.08);
        color: #f8fafc;
        border-color: rgba(255, 255, 255, 0.12);
    }

    .notification-bell-btn .bell-icon {
        width: 20px;
        height: 20px;
        fill: currentColor;
    }

    .notification-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: 9999px;
        background-color: #ef4444;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        line-height: 17px;
        text-align: center;
        box-shadow: 0 0 0 2px #161a1f;
    }

    .notification-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1040;
        background: transparent;
    }

    .notification-dropdown-panel {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 340px;
        max-width: 90vw;
        background-color: #191e24;
        border: 1px solid #384252;
        border-radius: 12px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
        z-index: 1050;
        overflow: hidden;
    }

    .animate-scale-in {
        animation: notifScaleIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        transform-origin: top right;
    }

    @@keyframes notifScaleIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(-4px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .notif-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background-color: #15191e;
        border-bottom: 1px solid #2a323c;
    }

    .notif-header-title {
        font-size: 14px;
        font-weight: 600;
        color: #f8fafc;
    }

    .notif-unread-pill {
        font-size: 11px;
        padding: 1px 7px;
        border-radius: 9999px;
        background-color: rgba(239, 68, 68, 0.2);
        color: #ef4444;
        font-weight: 700;
    }

    .notif-mark-read-btn {
        background: none;
        border: none;
        color: #10b981;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
        transition: background-color 0.15s ease;
    }

    .notif-mark-read-btn:hover {
        background-color: rgba(16, 185, 129, 0.12);
    }

    .notif-list-container {
        max-height: 380px;
        overflow-y: auto;
    }

    .notif-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        gap: 10px;
        color: #94a3b8;
        font-size: 13px;
    }

    .notif-spinner {
        width: 22px;
        height: 22px;
        border: 2px solid rgba(255, 255, 255, 0.15);
        border-top-color: #10b981;
        border-radius: 50%;
        animation: notifSpin 0.7s linear infinite;
    }

    @@keyframes notifSpin {
        to { transform: rotate(360deg); }
    }

    .notif-empty {
        text-align: center;
        padding: 36px 20px;
        color: #64748b;
    }

    .notif-empty-icon {
        width: 36px;
        height: 36px;
        fill: currentColor;
        opacity: 0.4;
        margin-bottom: 8px;
    }

    .notif-empty-title {
        font-size: 14px;
        font-weight: 500;
        color: #94a3b8;
    }

    .notif-empty-sub {
        font-size: 12px;
        color: #64748b;
        margin-top: 4px;
    }

    .notif-item {
        display: flex;
        align-items: flex-start;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        cursor: pointer;
        gap: 12px;
        transition: background-color 0.15s ease;
        position: relative;
    }

    .notif-item:hover {
        background-color: rgba(255, 255, 255, 0.05);
    }

    .notif-item.unread {
        background-color: rgba(16, 185, 129, 0.06);
    }

    .notif-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .notif-icon-box.icon-green { background-color: rgba(16, 185, 129, 0.15); color: #10b981; }
    .notif-icon-box.icon-red { background-color: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .notif-icon-box.icon-amber { background-color: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .notif-icon-box.icon-blue { background-color: rgba(59, 130, 246, 0.15); color: #3b82f6; }

    .notif-body {
        flex: 1;
        min-width: 0;
    }

    .notif-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
    }

    .notif-title {
        font-size: 13px;
        font-weight: 600;
        color: #f1f5f9;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notif-time {
        font-size: 11px;
        color: #64748b;
        flex-shrink: 0;
    }

    .notif-desc {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 3px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .notif-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10b981;
        flex-shrink: 0;
        margin-top: 6px;
    }

    /* True Viewport Fullscreen Modal Popup Styles */
    .notif-fullscreen-overlay {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        z-index: 99999 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        pointer-events: auto !important;
    }

    .notif-modal-backdrop {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        background-color: rgba(0, 0, 0, 0.78) !important;
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
        z-index: 1 !important;
    }

    .notif-modal-container {
        position: relative !important;
        z-index: 2 !important;
        width: 100% !important;
        max-width: 520px !important;
        padding: 16px !important;
        box-sizing: border-box !important;
        display: flex !important;
        justify-content: center !important;
    }

    .notif-modal-card {
        width: 100%;
        background-color: #191e24;
        border: 1px solid #384252;
        border-radius: 14px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85);
        overflow: hidden;
        animation: notifModalIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes notifModalIn {
        from {
            opacity: 0;
            transform: scale(0.92) translateY(12px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
