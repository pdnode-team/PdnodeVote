        1 or 6 => "icon-green",
        2 or 7 => "icon-red",
        3 or 5 => "icon-amber",
        _ => "icon-blue"
    };

    /// <summary>
    /// Normalizes the value's Kind before converting: the API serializes UTC without a zone marker,
    /// so values arrive as <see cref="DateTimeKind.Unspecified"/> and <c>ToLocalTime()</c> would be a
    /// no-op, showing UTC to every user outside UTC.
    /// </summary>
    private static DateTime AsUtc(DateTime value) => value.Kind switch
    {
        DateTimeKind.Utc => value,
        DateTimeKind.Local => value.ToUniversalTime(),
        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
    };

    private static string FormatLocal(DateTime utc, string format = "MMM dd, yyyy HH:mm") =>
        AsUtc(utc).ToLocalTime().ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - AsUtc(dt);
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays}d ago";
        return FormatLocal(dt, "MMM dd");
    }

    public async ValueTask DisposeAsync()
    {
        _retryTimer?.Dispose();
        _retryTimer = null;

        if (_hubConnection != null)
        {
            try
            {
                await _hubConnection.DisposeAsync();
            }
            catch { }
        }
    }
