@using PdnodeVote.Client.Models

@if (IsResultMode)
{
    <div class="result-option-box @(IsUserChoice ? "user-voted" : "")">
        @* InvariantCulture: a comma-decimal locale would render "width: 33,3%", which the browser
           rejects and the progress bar collapses to zero. *@
        <div class="result-progress-fill" style="width: @(Option.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
        <div class="result-content-wrap">
            <div class="d-flex align-center gap-3">
                @if (!string.IsNullOrEmpty(Option.ImageUrl))
                {
                    <div class="option-thumb-wrap" @onclick:stopPropagation="true" @onclick="@(() => OpenImagePreview(Option.ImageUrl))" title="Click to expand">
                        <img src="@Option.ImageUrl" alt="@Option.Text" class="option-thumb-img" />
                    </div>
                }
                <div class="d-flex align-center gap-2">
                    <span style="font-size: 14.5px; font-weight: 500; color: #f8fafc;">@Option.Text</span>
                    @if (IsUserChoice)
                    {
                        <span class="user-vote-badge">Your Vote</span>
                    }
                </div>
            </div>
            <div class="d-flex align-center gap-2">
                <span style="font-size: 14.5px; font-weight: 600; color: #34d399;">@Option.Percentage%</span>
                <span style="font-size: 12px; color: #64748b; font-weight: normal;">(@Option.VoteCount)</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="vote-option-row @(IsSelected ? "selected" : "")" @onclick="OnCardClick">
        <div class="d-flex align-center gap-3 flex-grow-1">
            @if (IsMultipleChoice)
            {
                <MudCheckBox T="bool"
                             Value="@IsSelected"
                             ValueChanged="@((_) => OnCardClick())"
                             Color="Color.Primary"
                             Class="ma-0 pa-0" />
            }
            else
            {
                <MudRadio Value="@Option.Id" Color="Color.Primary" Class="ma-0 pa-0" T="int" />
            }

            @if (!string.IsNullOrEmpty(Option.ImageUrl))
            {
                <div class="option-thumb-wrap" @onclick:stopPropagation="true" @onclick="@(() => OpenImagePreview(Option.ImageUrl))" title="Click to expand">
                    <img src="@Option.ImageUrl" alt="@Option.Text" class="option-thumb-img" />
                </div>
            }

            <span style="font-size: 14.5px; font-weight: 500; color: #f8fafc;">@Option.Text</span>
        </div>
    </div>
}

<!-- Image Lightbox Dialog -->
@if (_showLightbox && !string.IsNullOrEmpty(_lightboxUrl))
{
    <div class="lightbox-overlay" @onclick="@(() => _showLightbox = false)">
        <div class="lightbox-content" @onclick:stopPropagation="true">
            <button class="lightbox-close" @onclick="@(() => _showLightbox = false)">×</button>
            <img src="@_lightboxUrl" alt="Preview" class="lightbox-image" />
        </div>
    </div>
}

<style>
    .option-thumb-wrap {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        overflow: hidden;
        background: #0f1318;
        border: 1px solid rgba(255, 255, 255, 0.12);
        cursor: zoom-in;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .option-thumb-wrap:hover {
        transform: scale(1.05);
        border-color: rgba(56, 189, 248, 0.6);
    }

    .option-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .result-option-box {
        position: relative;
        background-color: #161a1f;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 10px;
        transition: border-color 0.2s ease;
    }

    .result-option-box.user-voted {
        border-color: rgba(16, 185, 129, 0.4);
    }

    .result-progress-fill {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        background-color: rgba(16, 185, 129, 0.15);
        border-right: 2px solid rgba(16, 185, 129, 0.5);
        transition: width 0.4s ease;
        pointer-events: none;
    }

    .result-content-wrap {
        position: relative;
        z-index: 1;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-vote-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 9999px;
        background-color: rgba(16, 185, 129, 0.2);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .vote-option-row {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background-color: #161a1f;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-bottom: 8px;
        cursor: pointer;
        user-select: none;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .vote-option-row:hover {
        border-color: rgba(16, 185, 129, 0.4);
        background-color: #191f26;
    }

    .vote-option-row.selected {
        border-color: #10b981;
        background-color: rgba(16, 185, 129, 0.08);
    }

    /* Lightbox */
    .lightbox-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.82);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .lightbox-content {
        position: relative;
        max-width: 90vw;
        max-height: 85vh;
    }

    .lightbox-close {
        position: absolute;
        top: -36px;
        right: 0;
        background: transparent;
        border: none;
        color: #f8fafc;
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
    }

    .lightbox-image {
        max-width: 90vw;
        max-height: 85vh;
        border-radius: 8px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
        object-fit: contain;
    }
</style>

@code {
    [Parameter]
    public PollOptionDto Option { get; set; } = null!;

    [Parameter]
    public bool IsResultMode { get; set; }

    [Parameter]
    public bool IsUserChoice { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool IsMultipleChoice { get; set; }

    [Parameter]
    public EventCallback OnSelect { get; set; }

    private bool _showLightbox = false;
    private string? _lightboxUrl;

    private Task OnCardClick() => OnSelect.InvokeAsync();

    private void OpenImagePreview(string url)
    {
        _lightboxUrl = url;
        _showLightbox = true;
    }
}
