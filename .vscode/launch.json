{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch and Debug Hosted Blazor WebAssembly App",
            "type": "blazorwasm",
            "request": "launch",
            "hosted": true,
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/bin/Debug/net10.0/PdnodeVote.dll",
            "cwd": "${workspaceFolder}",
            // Without this the debugger launches the dll directly and launchSettings.json is not
            // applied, so the app runs as Production: HSTS and the exception handler turn on, and
            // WebAssembly debugging is disabled.
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}